# イメージそのものは release に置く。git には入れない。
#
# 末尾に / を付けると、その名前の symlink は ignore されない。置き場を
# 別の区画へ逃がしたくなる類のものは、/ 無しでも書いておく。
imgs
imgs/
*.img
*.img.gz
*.console.log
*.mon
*.pid
*.qcow2
*.qemu
*.kernel
*.bootiso
*.dtb
*.ssh
*.id
*.id.pub
*.id.dsa
*.id.dsa.pub
*.seed
*.seed/
*.seed.log
*.seedpid
*.consolepid
*.tty

# 手元の媒体。18 GB あるうえ、大半は再配布の許されない商用 OS の
# 配布物なので、public なこのリポジトリには絶対に入れない。
# 実体でも symlink でも入れない。末尾に / を付けると symlink が漏れる。
disk_images
disk_images/
.DS_Store

# 組んだものの置き場
out
out/
media-paths.conf
