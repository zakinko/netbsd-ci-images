diff --git a/sys/ufs/ufs/dinode.h b/sys/ufs/ufs/dinode.h
index 172e3e33..b9caaa19 100644
--- a/sys/ufs/ufs/dinode.h
+++ b/sys/ufs/ufs/dinode.h
@@ -150,6 +150,53 @@ struct ufs2_dinode {
  */
 #define	APPLEUFS_MAXSYMLINKLEN 60
 
+/*
+ * The seconds of a UFS1 time are 32 bits wide and signed.  The
+ * nanoseconds beside them need only 30 bits, so the two bits above those
+ * count how many times 2^32 seconds have to be added to the seconds,
+ * which gives 1901 to 2446.  They are zero in an inode written before
+ * this, whose times thus keep their meaning.  The seconds are the same
+ * as without the two bits, so that code which does not know about them
+ * gets the time modulo 2^32.
+ */
+#define	UFS1_NSEC_BITS	30
+#define	UFS1_NSEC_MASK	0x3fffffff
+#define	UFS1_TIME_MIN	(-(int64_t)0x80000000LL)
+#define	UFS1_TIME_MAX	((int64_t)0x37fffffffLL)
+
+static __inline int64_t
+ufs1_time_sec(int32_t sec, int32_t nsec)
+{
+
+	/* Not written by this code if the nanoseconds are out of range. */
+	if ((nsec & UFS1_NSEC_MASK) >= 1000000000)
+		return sec;
+	return sec + ((int64_t)((uint32_t)nsec >> UFS1_NSEC_BITS) << 32);
+}
+
+static __inline int32_t
+ufs1_time_nsec(int32_t nsec)
+{
+
+	if ((nsec & UFS1_NSEC_MASK) >= 1000000000)
+		return 0;
+	return nsec & UFS1_NSEC_MASK;
+}
+
+/* Store a time, the nearest one possible if it is out of range. */
+static __inline void
+ufs1_time_set(int32_t *secp, int32_t *nsecp, int64_t sec, int32_t nsec)
+{
+
+	if (sec < UFS1_TIME_MIN)
+		sec = UFS1_TIME_MIN;
+	else if (sec > UFS1_TIME_MAX)
+		sec = UFS1_TIME_MAX;
+	*secp = (int32_t)(uint32_t)sec;
+	*nsecp = (int32_t)((uint32_t)nsec |
+	    (uint32_t)((uint64_t)(sec - *secp) >> 32) << UFS1_NSEC_BITS);
+}
+
 /* File permissions. */
 #define	IEXEC		0000100		/* Executable. */
 #define	IWRITE		0000200		/* Writable. */
