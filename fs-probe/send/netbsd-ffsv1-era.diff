+/*
+ * The verifier of an exclusive create is kept in the times of the new
+ * file.  Only the seconds are used, and of those 31 bits for each half
+ * of the verifier: a file system need not store nanoseconds which are
+ * none, nor seconds outside 1970 to 2038.
+ */
+__CTASSERT(NFSX_V3CREATEVERF == 2 * sizeof(uint32_t));
+
+static void
+nfsrv_cverf2times(const u_char *cverf, struct timespec *atime,
+    struct timespec *mtime)
+{
+	uint32_t w[2];
+
+	memcpy(w, cverf, sizeof(w));
+	atime->tv_sec = ntohl(w[0]) & 0x7fffffff;
+	atime->tv_nsec = 0;
+	mtime->tv_sec = ntohl(w[1]) & 0x7fffffff;
+	mtime->tv_nsec = 0;
+}
