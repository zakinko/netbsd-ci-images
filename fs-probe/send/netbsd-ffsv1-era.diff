diff --git a/sys/ufs/ufs/dinode.h b/sys/ufs/ufs/dinode.h
index 172e3e33..a8fb2b77 100644
--- a/sys/ufs/ufs/dinode.h
+++ b/sys/ufs/ufs/dinode.h
@@ -150,6 +150,69 @@ struct ufs2_dinode {
  */
 #define	APPLEUFS_MAXSYMLINKLEN 60
 
+/*
+ * The seconds of a UFS1 time are 32 bits wide and unsigned, as FreeBSD
+ * has them since 2025.  The nanoseconds beside them need only 30 bits,
+ * so the two bits above those give the 2^32 second era of the time:
+ *
+ *	0	1970 to 2106
+ *	1	2106 to 2242
+ *	2	2242 to 2378
+ *	3	1833 to 1970, that is before the epoch
+ *
+ * They are zero until 2106, so that until then code which does not know
+ * about them, but has the seconds unsigned, reads the same times.  A
+ * time before 1970 which was written with signed seconds reads as one
+ * after 2038.
+ */
+#define	UFS1_NSEC_BITS	30
+#define	UFS1_NSEC_MASK	0x3fffffff
+#define	UFS1_TIME_MIN	(-(int64_t)0x100000000LL)
+#define	UFS1_TIME_MAX	((int64_t)0x2ffffffffLL)
+
+static __inline int64_t
+ufs1_time_sec(int32_t sec, int32_t nsec)
+{
+	int64_t era;
+
+	/* Not written by this code if the nanoseconds are out of range. */
+	if ((nsec & UFS1_NSEC_MASK) >= 1000000000)
+		return (uint32_t)sec;
+	era = (uint32_t)nsec >> UFS1_NSEC_BITS;
+	if (era == 3)
+		era = -1;
+	return (int64_t)(uint32_t)sec + era * 0x100000000LL;
+}
+
+static __inline int32_t
+ufs1_time_nsec(int32_t nsec)
+{
+
+	if ((nsec & UFS1_NSEC_MASK) >= 1000000000)
+		return 0;
+	return nsec & UFS1_NSEC_MASK;
+}
+
+/*
+ * Store a time, the nearest one possible if it is out of range.  Not
+ * every caller has checked the nanoseconds, and they must not reach the
+ * two bits above them.
+ */
+static __inline void
+ufs1_time_set(int32_t *secp, int32_t *nsecp, int64_t sec, int64_t nsec)
+{
+
+	if (sec < UFS1_TIME_MIN)
+		sec = UFS1_TIME_MIN;
+	else if (sec > UFS1_TIME_MAX)
+		sec = UFS1_TIME_MAX;
+	if (nsec < 0 || nsec >= 1000000000)
+		nsec = 0;
+	*secp = (int32_t)(uint32_t)sec;
+	*nsecp = (int32_t)((uint32_t)nsec |
+	    (uint32_t)((uint64_t)sec >> 32) << UFS1_NSEC_BITS);
+}
+
 /* File permissions. */
 #define	IEXEC		0000100		/* Executable. */
 #define	IWRITE		0000200		/* Writable. */
