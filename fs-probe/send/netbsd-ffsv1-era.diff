diff --git a/tests/fs/ffs/t_ufs1time.c b/tests/fs/ffs/t_ufs1time.c
new file mode 100644
index 00000000..77fd4795
--- /dev/null
+++ b/tests/fs/ffs/t_ufs1time.c
@@ -0,0 +1,185 @@
+/*	$NetBSD$	*/
+
+/*
+ * Times beyond the year 2038 on FFSv1, PR kern/48449
+ */
+
+#include <atf-c.h>
+
+#define FSTEST_IMGSIZE (4000 * 512)
+#include "../common/h_fsmacros.h"
+
+#include <sys/types.h>
+#include <sys/mount.h>
+#include <sys/stat.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include <ufs/ufs/ufsmount.h>
+
+#include <rump/rump.h>
+#include <rump/rump_syscalls.h>
+
+#include "h_macros.h"
+
+#define Y2040	2209086245
+
+static const struct {
+	const char *name;
+	struct timespec ts;
+} times[] = {
+	{ "y1960", { -315521755, 123456789 } },
+	{ "y2030", { 1893553445, 123456789 } },
+	{ "y2040", { Y2040, 123456789 } },
+	{ "y2100", { 4102542245, 123456789 } },
+	{ "y2200", { 7258215845, 123456789 } },
+};
+
+/* Not nanoseconds, and neither UTIME_NOW nor UTIME_OMIT. */
+#define BADNSEC	0x40000005
+
+static void
+check(const char *when)
+{
+	struct stat sb;
+	size_t i;
+
+	for (i = 0; i < __arraycount(times); i++) {
+		RL(rump_sys_stat(times[i].name, &sb));
+		ATF_CHECK_MSG(sb.st_atime == times[i].ts.tv_sec &&
+		    sb.st_atimensec == times[i].ts.tv_nsec,
+		    "%s: atime of %s is %lld.%09ld", when, times[i].name,
+		    (long long)sb.st_atime, (long)sb.st_atimensec);
+		ATF_CHECK_MSG(sb.st_mtime == times[i].ts.tv_sec &&
+		    sb.st_mtimensec == times[i].ts.tv_nsec,
+		    "%s: mtime of %s is %lld.%09ld", when, times[i].name,
+		    (long long)sb.st_mtime, (long)sb.st_mtimensec);
+	}
+	if (rump_sys_stat("badnsec", &sb) == 0)
+		ATF_CHECK_MSG(sb.st_mtime == Y2040,
+		    "%s: mtime of badnsec is %lld.%09ld", when,
+		    (long long)sb.st_mtime, (long)sb.st_mtimensec);
+}
+
+static void
+ufs1time(const char *newfs_args)
+{
+	char cmd[1024];
+	struct ufs_args args;
+	struct timespec ts[2];
+	size_t i;
+	int fd;
+
+	snprintf(cmd, sizeof(cmd), "newfs -F -s %d %s %s > /dev/null",
+	    FSTEST_IMGSIZE / 512, newfs_args, FSTEST_IMGNAME);
+	if (system(cmd) != 0)
+		atf_tc_fail("cannot create file system");
+
+	rump_init();
+	if (rump_sys_mkdir(FSTEST_MNTNAME, 0777) == -1)
+		atf_tc_fail_errno("mount point create");
+
+	rump_pub_etfs_register("/diskdev", FSTEST_IMGNAME, RUMP_ETFS_BLK);
+
+	args.fspec = __UNCONST("/diskdev");
+
+	if (rump_sys_mount(MOUNT_FFS, FSTEST_MNTNAME, 0,
+	    &args, sizeof(args)) == -1)
+		atf_tc_fail_errno("mount ffs rw %s", FSTEST_MNTNAME);
+	RL(rump_sys_chdir(FSTEST_MNTNAME));
+
+	for (i = 0; i < __arraycount(times); i++) {
+		RL(fd = rump_sys_open(times[i].name, O_CREAT | O_RDWR, 0644));
+		ts[0] = ts[1] = times[i].ts;
+		RL(rump_sys_futimens(fd, ts));
+		RL(rump_sys_close(fd));
+	}
+
+	/*
+	 * Nanoseconds that are none may be refused, but if they are taken
+	 * they must not change the seconds.
+	 */
+	RL(fd = rump_sys_open("badnsec", O_CREAT | O_RDWR, 0644));
+	ts[0].tv_sec = ts[1].tv_sec = Y2040;
+	ts[0].tv_nsec = ts[1].tv_nsec = BADNSEC;
+	if (rump_sys_futimens(fd, ts) == -1) {
+		if (errno != EINVAL)
+			atf_tc_fail_errno("futimens");
+		RL(rump_sys_unlink("badnsec"));
+	}
+	RL(rump_sys_close(fd));
+
+	check("before unmount");
+
+	RL(rump_sys_chdir("/"));
+	RL(rump_sys_unmount(FSTEST_MNTNAME, 0));
+	if (rump_sys_mount(MOUNT_FFS, FSTEST_MNTNAME, MNT_RDONLY,
+	    &args, sizeof(args)) == -1)
+		atf_tc_fail_errno("mount ffs ro %s", FSTEST_MNTNAME);
+	RL(rump_sys_chdir(FSTEST_MNTNAME));
+
+	check("after remount");
+
+	RL(rump_sys_chdir("/"));
+	RL(rump_sys_unmount(FSTEST_MNTNAME, 0));
+
+	snprintf(cmd, sizeof(cmd), "fsck_ffs -fn %s > /dev/null",
+	    FSTEST_IMGNAME);
+	if (system(cmd) != 0)
+		atf_tc_fail("fsck_ffs does not find the file system clean");
+}
+
+ATF_TC(ufs1time_le);
+ATF_TC_HEAD(ufs1time_le, tc)
+{
+
+	atf_tc_set_md_var(tc, "descr", "times from 1960 to 2200 on "
+	    "little endian FFSv1");
+}
+
+ATF_TC_BODY(ufs1time_le, tc)
+{
+
+	ufs1time("-O 1 -B le");
+}
+
+ATF_TC(ufs1time_be);
+ATF_TC_HEAD(ufs1time_be, tc)
+{
+
+	atf_tc_set_md_var(tc, "descr", "times from 1960 to 2200 on "
+	    "big endian FFSv1");
+}
+
+ATF_TC_BODY(ufs1time_be, tc)
+{
+
+	ufs1time("-O 1 -B be");
+}
+
+ATF_TC(ufs1time_old);
+ATF_TC_HEAD(ufs1time_old, tc)
+{
+
+	atf_tc_set_md_var(tc, "descr", "times from 1960 to 2200 on "
+	    "FFSv1 in the 4.3BSD format");
+}
+
+ATF_TC_BODY(ufs1time_old, tc)
+{
+
+	ufs1time("-O 0");
+}
+
+ATF_TP_ADD_TCS(tp)
+{
+
+	ATF_TP_ADD_TC(tp, ufs1time_le);
+	ATF_TP_ADD_TC(tp, ufs1time_be);
+	ATF_TP_ADD_TC(tp, ufs1time_old);
+
+	return atf_no_error();
+}
