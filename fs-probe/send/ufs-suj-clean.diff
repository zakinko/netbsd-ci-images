diff --git a/fs/ufs/super.c b/fs/ufs/super.c
index 3569ac92b..f629e7bb7 100644
--- a/fs/ufs/super.c
+++ b/fs/ufs/super.c
@@ -575,6 +575,29 @@ static void ufs_put_cstotal(struct super_block *sb)
 	UFSD("EXIT\n");
 }
 
+/*
+ * FreeBSD and NetBSD have fs_clean at 0 (NetBSD: 2, FS_WASCLEAN) while a
+ * filesystem is mounted read-write and set it to 1 when it is unmounted, so
+ * that their fsck checks it after a crash.  This driver left it at 1.
+ */
+static void ufs_44bsd_set_clean(struct super_block *sb, bool clean)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+	struct ufs_super_block_first *usb1 = ubh_get_usb_first(uspi);
+
+	if ((UFS_SB(sb)->s_flags & UFS_ST_MASK) != UFS_ST_44BSD ||
+	    usb1->fs_clean == UFS_FSBAD)
+		return;
+	/* Everything else has to be on the disk before it is called clean. */
+	if (clean)
+		sync_blockdev(sb->s_bdev);
+	usb1->fs_clean = clean ? UFS_FSCLEAN : UFS_FSACTIVE;
+	ubh_mark_buffer_dirty(USPI_UBH(uspi));
+	/* FreeBSD's ffs_mountfs() waits for this write, too. */
+	if (!clean)
+		ubh_sync_block(USPI_UBH(uspi));
+}
+
 /**
  * ufs_put_super_internal() - put on-disk intrenal structures
  * @sb: pointer to super_block structure
@@ -617,6 +640,7 @@ static void ufs_put_super_internal(struct super_block *sb)
 		brelse (sbi->s_ucg[i]);
 	kfree (sbi->s_ucg);
 	kfree (base);
+	ufs_44bsd_set_clean(sb, true);
 
 	UFSD("EXIT\n");
 }
@@ -1060,6 +1084,12 @@ static int ufs_fill_super(struct super_block *sb, struct fs_context *fc)
 			UFSD("fs is clean\n");
 			break;
 		case UFS_FSSTABLE:
+			/* NetBSD's FS_WASCLEAN: mounted, or not unmounted */
+			if ((flags & UFS_ST_MASK) == UFS_ST_44BSD) {
+				pr_err("%s(): fs is active\n", __func__);
+				sb->s_flags |= SB_RDONLY;
+				break;
+			}
 			UFSD("fs is stable\n");
 			break;
 		case UFS_FSLOG:
@@ -1218,6 +1248,8 @@ static int ufs_fill_super(struct super_block *sb, struct fs_context *fc)
 		ret = -ENOMEM;
 		goto failed;
 	}
+	if (!sb_rdonly(sb))
+		ufs_44bsd_set_clean(sb, false);
 
 	UFSD("EXIT\n");
 	return 0;
@@ -1292,12 +1324,20 @@ static int ufs_reconfigure(struct fs_context *fc)
 			mutex_unlock(&UFS_SB(sb)->s_lock);
 			return -EINVAL;
 		}
+		/* ufs_fill_super() stays read-only on such a filesystem, too. */
+		if ((flags & UFS_ST_MASK) == UFS_ST_44BSD &&
+		    usb1->fs_clean != UFS_FSCLEAN) {
+			pr_err("fs is not clean, staying read-only\n");
+			mutex_unlock(&UFS_SB(sb)->s_lock);
+			return -EROFS;
+		}
 		if (!ufs_read_cylinder_structures(sb)) {
 			pr_err("failed during remounting\n");
 			mutex_unlock(&UFS_SB(sb)->s_lock);
 			return -EPERM;
 		}
 		sb->s_flags &= ~SB_RDONLY;
+		ufs_44bsd_set_clean(sb, false);
 #endif
 	}
 	UFS_SB(sb)->s_on_err = ctx->on_err;
