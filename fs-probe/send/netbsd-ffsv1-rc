#!/bin/sh
# /etc/rc として走る。ld0 が root、ld1..ld4 が試験のディスク。
PATH=/sbin:/bin:/usr/sbin:/usr/bin; export PATH; TZ=UTC; export TZ
mount -u -o rw / 2>&1
(cd /dev && sh MAKEDEV ld1 ld2 ld3 ld4 > /dev/null 2>&1)
mount -t tmpfs tmpfs /w
echo "T# kernel $(uname -rv)"
K=$(cat /testkernel)
show() {
	for f in w1800 w1960 w2030 w2040 w2100 w2400 w2500; do
		[ -e /mnt/$f ] && echo "T $1 $f $(stat -f '%m %Sm' -t '%Y-%m-%d' /mnt/$f) nsec $(stat -f '%Fm' /mnt/$f | sed 's/.*\.//')"
	done
	[ -e /mnt/now ] && echo "T $1 now $(stat -f '%Sm' -t '%Y-%m-%d' /mnt/now)"
}
date 204001020304 > /dev/null 2>&1; echo "T date $(date)"
P=/new; [ $K = new ] || P=/sbin
TMPDIR=/w; export TMPDIR
for t in "ld1 1 le" "ld2 0 le" "ld3 1 be"; do
	set -- $t; d=$1; o=$2; e=$3; n=ffsv1-O$o-$e
	if [ $K = new ]; then
		$P/newfs -I -O $o -B $e /dev/r${d}d > /w/nf 2>&1 || { echo "T $n newfs failed: $(tail -1 /w/nf)"; continue; }
	fi
	mount -t ffs /dev/${d}d /mnt || { echo "T $n mount failed"; continue; }
	if [ $K = new ]; then
		for y in 1800 1960 2030 2040 2100 2400 2500; do : > /mnt/w$y; touch -d "$y-01-02T03:04:05.123456789Z" /mnt/w$y 2>&1; done
		echo hello > /mnt/now
		show "$n cached"
		umount /mnt; mount -t ffs /dev/${d}d /mnt
	fi
	show "$n remounted"
	umount /mnt
	$P/fsck_ffs -fn /dev/r${d}d > /w/fk 2>&1; echo "T $n fsck exit $? $(grep -vE '^\*\*|files,|^$' /w/fk | head -3 | tr '\n' ';')"
	if [ $K = new ]; then
		printf 'inode 2\nlookup w2040\nquit\n' | $P/fsdb -n -f /dev/r${d}d 2>&1 | grep -E 'TIME=' | tail -3 | sed "s/^/T $n fsdb /"
		$P/dump -0 -a -f /w/d0 /dev/r${d}d > /w/dl 2>&1; echo "T $n dump exit $? $(ls -l /w/d0) $(tail -3 /w/dl | tr '\n' ';')"
		$P/newfs -I -O 1 /dev/rld4d > /dev/null 2>&1 && mount -t ffs /dev/ld4d /mnt && (cd /mnt && $P/restore -rf /w/d0 > /w/rl 2>&1; echo "T $n restore exit $? $(tail -4 /w/rl | tr '\n' ';')")
		show "$n restored"; umount /mnt
		# 増分: 2039 年を基準にして、2040 年の file が入るか
		for w in $P/dump /sbin/dump; do
			$w -1 -a -T "Sun Jan  2 00:00:00 2039" -f /w/d1 /dev/r${d}d > /w/dl 2>&1
			echo "T $n incremental $w exit $? $(tail -2 /w/dl | tr '\n' ';') list: $($P/restore -tf /w/d1 2>&1 | tail -6 | tr '\n' ';'): $($P/restore -tf /w/d1 2>/dev/null | grep -cE '/(now|w2040|w2100)$') of 3"
		done
		rm -f /w/d0 /w/d1
	fi
done
echo "T ALLDONE"
sync; halt -p
