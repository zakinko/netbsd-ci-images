#!/bin/sh
# /etc/rc として走る。ld0 が root、ld1.. が FreeBSD の作った image。
# /testmode: clean (書いて umount)、kill (書いている最中にホストが qemu を殺す)
PATH=/sbin:/bin:/usr/sbin:/usr/bin; export PATH
mount -u -o rw / 2>&1
(cd /dev && sh MAKEDEV ld1 ld2 ld3 ld4 > /dev/null 2>&1)
mount -t tmpfs tmpfs /w
M=$(cat /testmode); K=$(cat /testkernel)
echo "T# $K $M $(uname -v | cut -c1-60)"
n=0
for i in $(cat /testimages); do
	n=$((n + 1)); d=ld$n
	if [ $M = fsckit ]; then
		mount -t ffs -o ro /dev/${d}d /mnt > /w/m 2>&1; echo "T $i unclean ro mount exit $? $(tail -1 /w/m)"; umount /mnt 2>/dev/null
		mount -t ffs -o rw /dev/${d}d /mnt > /w/m 2>&1; echo "T $i unclean rw mount exit $? $(tail -1 /w/m)"; umount /mnt 2>/dev/null
		/new/fsck_ffs -y -f /dev/r${d}d > /w/f 2>&1; echo "T $i fsck -y exit $? unknown-flags $(grep -c 'UNKNOWN FLAGS' /w/f) $(tail -2 /w/f | tr '\n' ';')"
		/new/fsck_ffs -n -f /dev/r${d}d > /w/f 2>&1; echo "T $i fsck -n exit $? $(grep -vE '^\*\*|files,|^$' /w/f | head -3 | tr '\n' ';')"
		dumpfs /dev/r${d}d 2>/dev/null | grep -iE 'clean|^flags' | head -3 | sed "s/^/T $i dumpfs /"
		mount -t ffs -o rw /dev/${d}d /mnt > /w/m 2>&1; echo "T $i after fsck rw mount exit $? $(tail -1 /w/m)"; umount /mnt 2>/dev/null
		continue
	fi
	mount -t ffs -o ro /dev/${d}d /mnt > /w/m 2>&1; echo "T $i ro mount exit $? $(tail -1 /w/m)"
	[ -f /mnt/seed/f1 ] && echo "T $i ro reads seed: $(cksum < /mnt/seed/f1)"
	umount /mnt 2>/dev/null
	mount -t ffs -o ro /dev/${d}d /mnt 2>/dev/null && { mount -u -o rw /dev/${d}d /mnt > /w/m 2>&1; echo "T $i remount rw exit $? $(tail -1 /w/m)"; umount /mnt; }
	mount -t ffs -o rw /dev/${d}d /mnt > /w/m 2>&1; r=$?; echo "T $i rw mount exit $r $(tail -1 /w/m)"
	if [ $r != 0 ] && [ $K = old ]; then
		mount -t ffs -o rw,force /dev/${d}d /mnt > /w/m 2>&1; r=$?; echo "T $i rw,force mount exit $r $(tail -1 /w/m)"
	fi
	[ $r = 0 ] || continue
	mkdir -p /mnt/nb/a/b/c && cp /bin/ls /mnt/nb/a/b/c/ && rm -rf /mnt/seed/d1 && mkdir /mnt/nb/reuse && echo x > /mnt/nb/reuse/x
	mv /mnt/nb/a/b /mnt/nb/b
	if [ $M = kill ]; then
		sync; sync
		(j=0; while :; do mkdir -p /mnt/w/$j; for k in 1 2 3 4 5 6 7 8 9; do dd if=/dev/zero of=/mnt/w/$j/$k bs=3000 count=$k 2>/dev/null; done; [ $((j % 3)) = 0 ] && rm -rf /mnt/w/$((j / 2)); j=$((j + 1)); done) &
	else
		i2=0; while [ $i2 -lt 200 ]; do mkdir -p /mnt/w/$i2; echo $i2 > /mnt/w/$i2/f; i2=$((i2 + 1)); done
		umount /mnt; echo "T $i umount exit $?"
		dumpfs /dev/r${d}d 2>/dev/null | grep -iE 'clean|flags' | head -4 | sed "s/^/T $i dumpfs /"
	fi
	[ $M = kill ] && break
done
if [ $M = kill ]; then sleep 8; echo "T KILLME"; sleep 600; fi
echo "T ALLDONE"; sync; halt -p
