+	/*
+	 * If this is a junction or a symlink to a path on a drive,
+	 * translate the link target.
+	 */
+	if (rp->ReparseTag == IO_REPARSE_TAG_MOUNT_POINT ||
+	    ntfs_symlink_on_drive(rp, buffer))
 		err = ntfs_translate_junction(sb, link_de, buffer, err, buflen);
 
