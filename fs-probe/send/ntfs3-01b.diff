+/*
+ * ntfs_path_on_drive - Is this a full path on a drive, such as C:/dir?
+ *
+ * Windows always has a separator after the colon of a full path.  Without
+ * it the colon is just a character of a name, as far as Linux is
+ * concerned.
+ */
+static bool ntfs_path_on_drive(const char *path)
+{
+	return isalpha(path[0]) && path[1] == ':' &&
+	       (path[2] == '/' || path[2] == '\\');
+}
+
 static struct REPARSE_DATA_BUFFER *
 ntfs_create_reparse_buffer(struct ntfs_sb_info *sbi, const char *symname,
 			   u32 size, u16 *nsize)
@@ -1321,7 +1335,7 @@ ntfs_create_reparse_buffer(struct ntfs_sb_info *sbi, const char *symname,
 	typeof(rp->SymbolicLinkReparseBuffer) *rs;
 	bool is_absolute;
 
-	is_absolute = symname[0] && symname[1] == ':';
+	is_absolute = ntfs_path_on_drive(symname);
 
 	rp = kzalloc(ntfs_reparse_bytes(2 * size + 2, is_absolute), GFP_NOFS);
 	if (!rp)
@@ -2036,7 +2050,8 @@ void ntfs_evict_inode(struct inode *inode)
 /*
  * ntfs_translate_junction
  *
- * Translate a Windows junction target to the Linux equivalent.
+ * Translate the target of a Windows junction, or of a symlink to a path
+ * on a drive, to the Linux equivalent.
  * On junctions, targets are always absolute (they include the drive
  * letter). We have no way of knowing if the target is for the current
  * mounted device or not so we just assume it is.
@@ -2216,6 +2231,28 @@ static int ntfs_strip_nt_prefix(char *name, int len)
 	return len - prefix_len;
 }
 
+/*
+ * ntfs_symlink_on_drive - Is a symlink target a full path on a drive?
+ * @rp:		reparse data of the link.
+ * @target:	link target, already with '\' turned into '/'.
+ *
+ * MS-FSCC 2.1.2.4: without SYMLINK_FLAG_RELATIVE the target is a full
+ * path name.  Windows writes it with a drive letter, as in C:/dir, which
+ * means nothing on this side, so such a target is translated the way a
+ * junction is.  A full path without a drive letter, such as a UNC name,
+ * is left as it is.
+ */
+static bool ntfs_symlink_on_drive(const struct REPARSE_DATA_BUFFER *rp,
+				  const char *target)
+{
+	if (rp->ReparseTag != IO_REPARSE_TAG_SYMLINK)
+		return false;
+	if (le32_to_cpu(rp->SymbolicLinkReparseBuffer.Flags) &
+	    SYMLINK_FLAG_RELATIVE)
+		return false;
+	return ntfs_path_on_drive(target);
+}
