+/*
+ * Zero @n fragments from @beg on the device itself.  A block taken for a
+ * page being written is larger than the page when the block is, and its
+ * other fragments may be read back from the device before anything else
+ * writes them, so the zeroes have to be there already.  This used to be
+ * done with sync_dirty_buffer() a fragment at a time, a synchronous write
+ * for every fragment of every new block, which was most of the time spent
+ * writing a new file; one zeroout covers the run.  Buffers that the block
+ * device's cache still holds over these fragments would later be written
+ * back over the file's data, so they are dropped first.
+ */
+static int ufs_zero_frags_now(struct inode *inode, sector_t beg,
+			      unsigned int n)
+{
+	struct super_block *sb = inode->i_sb;
+	unsigned int shift = UFS_SB(sb)->s_uspi->s_nspfshift;
+
+	clean_bdev_aliases(sb->s_bdev, beg, n);
+	return blkdev_issue_zeroout(sb->s_bdev, beg << shift,
+				    (sector_t)n << shift, GFP_NOFS, 0);
+}
+
 static void ufs_clear_frags(struct inode *inode, sector_t beg, unsigned int n,
 			    int sync)
 {
 	struct buffer_head *bh;
 	sector_t end = beg + n;
 
+	if ((IS_SYNC(inode) || sync) && !ufs_zero_frags_now(inode, beg, n))
+		return;
 	for (; beg < end; ++beg) {
 		bh = sb_getblk(inode->i_sb, beg);
