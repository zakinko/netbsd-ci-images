+/*
+ * With -o lazyzero, zero the @n new fragments from file fragment @fragment
+ * in the page cache rather than on the device, so that a hole filled by a
+ * small write does not wait for a synchronous write of the rest of its
+ * block.  Writeback puts the zeroes on the device, in no order with the
+ * block pointer: a crash can leave old disk contents in the block, which
+ * is what the option asks to accept.
+ *
+ * The caller holds s_lock, and writeback holds a folio lock when it takes
+ * s_lock, so a folio that is not free right now is not waited for.  Pages
+ * that the new fragments do not cover whole are left to the caller, as they
+ * can hold data of older fragments that are not in the cache.
+ */
+static bool ufs_zero_frags_cached(struct inode *inode, u64 fragment,
+				  unsigned int n, struct page *locked_page)
+{
+	struct address_space *mapping = inode->i_mapping;
+	unsigned int fshift = UFS_SB(inode->i_sb)->s_uspi->s_fshift;
+	unsigned int shift = PAGE_SHIFT - fshift;
+	u64 end = fragment + n;
+	pgoff_t index;
+
+	if (fshift > PAGE_SHIFT)
+		return false;
+	/*
+	 * Writeback drops a folio wholly past i_size and the buffers past it
+	 * in one that straddles i_size, and i_size moves only when the write
+	 * ends, so zeroes left in the cache there would never be written.
+	 */
+	if (end > ((u64)i_size_read(inode) + (1U << fshift) - 1) >> fshift)
+		return false;
+	for (index = fragment >> shift; (u64)index << shift < end; index++) {
+		struct folio *folio;
+
+		if (index == locked_page->index) {
+			ufs_zero_frags_in_folio(page_folio(locked_page), fragment, end, fshift);
+			continue;
+		}
+		if ((u64)index << shift < fragment ||
+		    (u64)(index + 1) << shift > end)
+			return false;
+		folio = __filemap_get_folio(mapping, index,
+				FGP_LOCK | FGP_CREAT | FGP_NOWAIT,
+				mapping_gfp_constraint(mapping, GFP_NOFS));
+		if (IS_ERR(folio))
+			return false;
+		if (!folio_test_uptodate(folio)) {
+			folio_zero_range(folio, 0, folio_size(folio));
+			folio_mark_uptodate(folio);
+		}
+		if (!folio_buffers(folio))
+			create_empty_buffers(folio, 1 << inode->i_blkbits, 0);
+		block_dirty_folio(mapping, folio);
+		folio_unlock(folio);
+		folio_put(folio);
+	}
+	return true;
+}
