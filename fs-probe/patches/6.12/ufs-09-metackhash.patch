+++ b/fs/ufs/ckhash.c
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * FreeBSD's metadata check-hashes.
+ *
+ * FreeBSD keeps a CRC32C of the superblock, of each cylinder group and
+ * of each UFS2 inode when FS_METACKHASH is set in fs_flags, and names
+ * which of them in fs_metackhash.  It refuses a superblock or cylinder
+ * group whose check-hash does not match, so whoever changes one has to
+ * update its check-hash as well.  There is no separate specification;
+ * what follows is from FreeBSD's sys/ufs/ffs/fs.h, ffs_subr.c
+ * (ffs_calc_sbhash, ffs_update_dinode_ckhash) and ffs_alloc.c
+ * (ffs_ckhash_cg).
+ *
+ * Each check-hash is calculate_crc32c(~0, ...) over the whole structure
+ * with the check-hash field taken as zero.  FreeBSD's calculate_crc32c()
+ * does not invert the result, and neither does crc32c(), so the two
+ * agree.  The field is skipped rather than cleared in the buffer, so
+ * that writeback never sees it zeroed.
+ *
+ * NetBSD uses the bit of FS_METACKHASH for FS_DOQUOTA2 and leaves
+ * fs_metackhash zero, so check-hashes are kept only when both are set.
+ *
+ * A check-hash that does not match on reading is reported, and then the
+ * check-hashes are given up the way FreeBSD's fs.h asks of a kernel that
+ * does not maintain them: FS_METACKHASH is cleared, FreeBSD stops
+ * verifying them, and its fsck rebuilds them.
+ */
+
+#include <linux/crc32c.h>
+#include <linux/fs.h>
+#include <linux/buffer_head.h>
+
+#include "ufs_fs.h"
+#include "ufs.h"
+#include "swab.h"
+#include "util.h"
+
+/* fs_metackhash; FreeBSD's CK_ flags. */
+#define UFS_CK_SUPERBLOCK	0x0001U
+#define UFS_CK_CYLGRP		0x0002U
+#define UFS_CK_INODE		0x0004U
+#define UFS_CK_SUPPORTED	0x0007U	/* the ones FreeBSD maintains */
+
+/* fs_ckhash sits in the third sector of the superblock. */
+#define UFS_SB_CKHASH_OFFSET \
+	(2 * UFS_SECTOR_SIZE + \
+	 offsetof(struct ufs_super_block_third, fs_un2.fs_44.fs_ckhash))
+#define UFS_CG_CKHASH_OFFSET \
+	offsetof(struct ufs_cylinder_group, cg_u.cg_u2.cg_ckhash)
+
+static bool ufs_ckhash_kept(struct super_block *sb, u32 kind)
+{
+	return UFS_SB(sb)->s_metackhash & kind;
+}
+
+/* CRC32C of the first @len bytes of @data, with the 4 bytes at @skip as 0. */
+static u32 ufs_crc32c_skip(u32 crc, const u8 *data, unsigned int len,
+			   unsigned int skip)
+{
+	static const u8 zero[4];
+
+	crc = crc32c(crc, data, skip);
+	crc = crc32c(crc, zero, sizeof(zero));
+	return crc32c(crc, data + skip + sizeof(zero),
+		      len - skip - (unsigned int)sizeof(zero));
+}
+
+/*
+ * The same over the first @len bytes of a ufs_buffer_head, whose buffers
+ * each hold @bsize bytes.
+ */
+static u32 ufs_crc32c_ubh(struct ufs_buffer_head *ubh, unsigned int bsize,
+			  unsigned int len, unsigned int skip)
+{
+	u32 crc = ~0U;
+	unsigned int i;
+
+	for (i = 0; i < ubh->count && len; i++) {
+		unsigned int n = min(len, bsize);
+		const u8 *data = (const u8 *)ubh->bh[i]->b_data;
+
+		if (skip < n) {
+			crc = ufs_crc32c_skip(crc, data, n, skip);
+			skip = UINT_MAX;	/* skipped; none in later buffers */
+		} else {
+			crc = crc32c(crc, data, n);
+			if (skip != UINT_MAX)
+				skip -= n;
+		}
+		len -= n;
+	}
+	return crc;
+}
+
+static __fs32 *ufs_ubh_field(struct ufs_buffer_head *ubh, unsigned int bsize,
+			     unsigned int offset)
+{
+	return (__fs32 *)(ubh->bh[offset / bsize]->b_data + offset % bsize);
+}
+
+static u32 ufs_sb_ckhash(struct super_block *sb)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+
+	return ufs_crc32c_ubh(USPI_UBH(uspi), uspi->s_fsize, uspi->s_sbsize,
+			      UFS_SB_CKHASH_OFFSET);
+}
+
+static u32 ufs_cg_ckhash(struct super_block *sb, struct ufs_buffer_head *ubh)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+
+	return ufs_crc32c_ubh(ubh, uspi->s_fsize, uspi->s_cgsize,
+			      UFS_CG_CKHASH_OFFSET);
+}
+
+static u32 ufs_inode_ckhash(struct ufs2_inode *ui)
+{
+	return ufs_crc32c_skip(~0U, (const u8 *)ui, (unsigned int)sizeof(*ui),
+			       (unsigned int)offsetof(struct ufs2_inode,
+						      ui_ckhash));
+}
+
+/* Stop keeping check-hashes; the caller has said why. */
+static void ufs_ckhash_give_up(struct super_block *sb)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+	struct ufs_super_block_third *usb3 = ubh_get_usb_third(uspi);
+	u32 flags;
+
+	UFS_SB(sb)->s_metackhash = 0;
+	pr_warn("%s: no longer keeping FreeBSD's metadata check-hashes; fsck_ffs on FreeBSD rebuilds them\n",
+		sb->s_id);
+	if (sb_rdonly(sb))
+		return;
+	flags = fs32_to_cpu(sb, usb3->fs_un2.fs_44.fs_flags);
+	usb3->fs_un2.fs_44.fs_flags = cpu_to_fs32(sb, flags & ~UFS_METACKHASH);
+	ubh_mark_buffer_dirty(USPI_UBH(uspi));
+	ufs_mark_sb_dirty(sb);
+}
+
+static void ufs_ckhash_mismatch(struct super_block *sb, const char *what,
+				u64 which)
+{
+	if (!UFS_SB(sb)->s_metackhash)
+		return;
+	pr_warn("%s: check-hash of %s %llu does not match\n",
+		sb->s_id, what, which);
+	ufs_ckhash_give_up(sb);
+}
+
+/*
+ * Decide at mount which check-hashes to keep, and verify the superblock's.
+ * The superblock has been read; nothing has been written yet.
+ */
+void ufs_ckhash_mount(struct super_block *sb)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+	struct ufs_super_block_third *usb3 = ubh_get_usb_third(uspi);
+	u32 flags, metackhash, ckhash;
+
+	/* FreeBSD's dinode.h: 256 bytes, di_ckhash at 244 */
+	BUILD_BUG_ON(sizeof(struct ufs2_inode) != 256);
+	BUILD_BUG_ON(offsetof(struct ufs2_inode, ui_ckhash) != 244);
+
+	UFS_SB(sb)->s_metackhash = 0;
+	if ((UFS_SB(sb)->s_flags & UFS_ST_MASK) != UFS_ST_44BSD)
+		return;
+	flags = fs32_to_cpu(sb, usb3->fs_un2.fs_44.fs_flags);
+	metackhash = fs32_to_cpu(sb, usb3->fs_un2.fs_44.fs_metackhash);
+	if (!(flags & UFS_METACKHASH) || !metackhash)
+		return;
+	UFS_SB(sb)->s_metackhash = metackhash & UFS_CK_SUPPORTED;
+	/*
+	 * A cylinder group is read in whole fragments.  FreeBSD's newfs
+	 * rounds fs_cgsize up to one; do not guess at one that is not.
+	 */
+	if (uspi->s_cgsize % uspi->s_fsize) {
+		pr_warn("%s: cylinder group size %u is not a whole number of fragments\n",
+			sb->s_id, uspi->s_cgsize);
+		ufs_ckhash_give_up(sb);
+		return;
+	}
+	if (!ufs_ckhash_kept(sb, UFS_CK_SUPERBLOCK))
+		return;
+	ckhash = fs32_to_cpu(sb, *ufs_ubh_field(USPI_UBH(uspi), uspi->s_fsize,
+						 UFS_SB_CKHASH_OFFSET));
+	if (ckhash != ufs_sb_ckhash(sb))
+		ufs_ckhash_mismatch(sb, "superblock", 0);
+}
+
+/*
+ * A read-only mount does not give up check-hashes on disk.  Before the
+ * filesystem becomes writable, clear FS_METACKHASH if they are on disk
+ * but no longer kept.
+ */
+void ufs_ckhash_remount_rw(struct super_block *sb)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+	struct ufs_super_block_third *usb3 = ubh_get_usb_third(uspi);
+	u32 flags;
+
+	if (UFS_SB(sb)->s_metackhash ||
+	    (UFS_SB(sb)->s_flags & UFS_ST_MASK) != UFS_ST_44BSD ||
+	    !usb3->fs_un2.fs_44.fs_metackhash)
+		return;
+	flags = fs32_to_cpu(sb, usb3->fs_un2.fs_44.fs_flags);
+	if (!(flags & UFS_METACKHASH))
+		return;
+	usb3->fs_un2.fs_44.fs_flags = cpu_to_fs32(sb, flags & ~UFS_METACKHASH);
+	ubh_mark_buffer_dirty(USPI_UBH(uspi));
+}
+
+/* Mark the superblock dirty, with its check-hash brought up to date. */
+void ufs_mark_usb_dirty(struct super_block *sb)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+
+	if (ufs_ckhash_kept(sb, UFS_CK_SUPERBLOCK))
+		*ufs_ubh_field(USPI_UBH(uspi), uspi->s_fsize,
+			       UFS_SB_CKHASH_OFFSET) =
+			cpu_to_fs32(sb, ufs_sb_ckhash(sb));
+	ubh_mark_buffer_dirty(USPI_UBH(uspi));
+}
+
+/* Mark a cylinder group dirty, with its check-hash brought up to date. */
+void ufs_mark_cg_dirty(struct super_block *sb, struct ufs_cg_private_info *ucpi)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+	struct ufs_buffer_head *ubh = UCPI_UBH(ucpi);
+
+	if (ufs_ckhash_kept(sb, UFS_CK_CYLGRP))
+		*ufs_ubh_field(ubh, uspi->s_fsize, UFS_CG_CKHASH_OFFSET) =
+			cpu_to_fs32(sb, ufs_cg_ckhash(sb, ubh));
+	ubh_mark_buffer_dirty(ubh);
+}
+
+/* Verify a cylinder group that has just been read in full. */
+void ufs_ckhash_check_cg(struct super_block *sb, struct ufs_buffer_head *ubh,
+			 unsigned int cgno)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+	u32 ckhash;
+
+	if (!ufs_ckhash_kept(sb, UFS_CK_CYLGRP))
+		return;
+	ckhash = fs32_to_cpu(sb, *ufs_ubh_field(ubh, uspi->s_fsize,
+						 UFS_CG_CKHASH_OFFSET));
+	if (ckhash != ufs_cg_ckhash(sb, ubh))
+		ufs_ckhash_mismatch(sb, "cylinder group", cgno);
+}
+
+/*
+ * Bring the check-hash of a UFS2 inode up to date.  FreeBSD keeps none
+ * for an inode whose mode is zero.
+ */
+void ufs_ckhash_set_inode(struct super_block *sb, struct ufs2_inode *ui)
+{
+	if (ufs_ckhash_kept(sb, UFS_CK_INODE) && ui->ui_mode)
+		ui->ui_ckhash = cpu_to_fs32(sb, ufs_inode_ckhash(ui));
+}
+
+/* Verify a UFS2 inode that has just been read. */
+void ufs_ckhash_check_inode(struct super_block *sb, struct ufs2_inode *ui,
+			    u64 ino)
+{
+	if (!ufs_ckhash_kept(sb, UFS_CK_INODE) || !ui->ui_mode)
+		return;
+	if (fs32_to_cpu(sb, ui->ui_ckhash) != ufs_inode_ckhash(ui))
+		ufs_ckhash_mismatch(sb, "inode", ino);
+}
