+static unsigned int ufs_frags_to_zero(struct inode *inode, u64 fragment,
+				      unsigned int n, struct page *page)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(inode->i_sb)->s_uspi;
+	u64 eof = ((u64)i_size_read(inode) + uspi->s_fsize - 1) >>
+		  uspi->s_fshift;
