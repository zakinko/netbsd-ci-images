+ * @inode is to grow from @from to @to bytes with nothing written in
+ * between.  Zero on the device the fragments that the new size takes in
+ * and that ufs_new_fragments() left as they were.  Only the block that
+ * holds EOF can have such fragments, as blocks wholly past EOF are freed
+ * by truncation, and only as far as i_lastfrag: a short file's last
+ * block is allocated a fragment at a time, and the fragments after it
+ * belong to someone else.
+ */
+static int ufs_zero_past_eof(struct inode *inode, loff_t from, loff_t to)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(inode->i_sb)->s_uspi;
+	u64 first = ((u64)from + uspi->s_fsize - 1) >> uspi->s_fshift;
+	u64 last = ((u64)to + uspi->s_fsize - 1) >> uspi->s_fshift;
+	unsigned int offsets[4];
+	int depth;
+	u64 phys64;
+
+	last = min(last, (first | uspi->s_fpbmask) + 1);
+	depth = ufs_block_to_path(inode, first >> uspi->s_fpbshift, offsets);
+	if (!depth)
+		return 0;
+	mutex_lock(&UFS_I(inode)->truncate_mutex);
+	last = min(last, UFS_I(inode)->i_lastfrag);
+	phys64 = first < last ? ufs_frag_map(inode, offsets, depth) : 0;
+	mutex_unlock(&UFS_I(inode)->truncate_mutex);
+	if (!phys64)
+		return 0;
+	return ufs_zero_frags_now(inode, phys64 + ufs_fragnum(first),
+				  (unsigned int)(last - first));
+}
