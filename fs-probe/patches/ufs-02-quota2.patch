+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * NetBSD in-filesystem quotas ("quota2").
+ *
+ * NetBSD keeps the per-user and per-group usage and limits in two hidden
+ * inodes named by the superblock, and its fsck checks them against the
+ * filesystem.  A write that does not update them leaves fsck reporting a
+ * quota mismatch for every owner whose usage changed.  There is no
+ * separate specification; the layout below follows NetBSD's
+ * sys/ufs/ufs/quota2.h, and the update rules its sys/ufs/ufs/ufs_quota2.c.
+ *
+ * Everything on disk is in the filesystem's byte order, except the two
+ * single-byte header fields.
+ */
+
+#ifndef _UFS_QUOTA2_H
+#define _UFS_QUOTA2_H
+
+#include "ufs_fs.h"
+
+#define UFS_Q2_HEAD_MAGIC	0xb746915eU	/* Q2_HEAD_MAGIC */
+
+/* Quota types; the index into fs_quotafile[] and the bit in fs_quota_flags. */
+#define UFS_Q2_USR		0		/* USRQUOTA */
+#define UFS_Q2_GRP		1		/* GRPQUOTA */
+#define UFS_Q2_NTYPES		2		/* MAXQUOTAS */
+#define UFS_Q2_DO_TYPE(type)	(0x01U << (type))	/* FS_Q2_DO_TYPE() */
+
+/* What a quota2_val counts. */
+#define UFS_Q2_BLOCK		0	/* QL_BLOCK: 512-byte units, as di_blocks */
+#define UFS_Q2_FILE		1	/* QL_FILE: inodes */
+#define UFS_Q2_NQL		2	/* N_QL */
+
+struct ufs_q2_val {
+	__fs64	q2v_hardlimit;
+	__fs64	q2v_softlimit;
+	__fs64	q2v_cur;		/* current usage */
+	__fs64	q2v_time;		/* when the soft limit grace runs out */
+	__fs64	q2v_grace;
+};
+
+struct ufs_q2_entry {
+	struct ufs_q2_val q2e_val[UFS_Q2_NQL];
+	__fs64	q2e_next;		/* byte offset of the next entry, or 0 */
+	__fs32	q2e_uid;		/* the user or group it counts */
+	__fs32	q2e_pad;
+};
+
+struct ufs_q2_header {
+	__fs32	q2h_magic_number;
+	__u8	q2h_type;
+	__u8	q2h_hash_shift;
+	__fs16	q2h_hash_size;		/* 1 << q2h_hash_shift */
+	struct ufs_q2_entry q2h_defentry;	/* copied into new entries */
+	__fs64	q2h_free;		/* head of the free entry list */
+	__fs64	q2h_entries[];		/* hash table, q2h_hash_size heads */
+};
+
+int ufs_quota2_load(struct super_block *sb);
+void ufs_quota2_unload(struct super_block *sb);
+bool ufs_quota2_active(struct super_block *sb);
+void ufs_quota2_sync_blocks(struct inode *inode);
+void ufs_quota2_new_inode(struct inode *inode);
+void ufs_quota2_free_inode(struct inode *inode);
+int ufs_quota2_transfer(struct inode *inode, const struct iattr *attr);
+
+#endif /* _UFS_QUOTA2_H */
