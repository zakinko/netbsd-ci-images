--- a/fs/ufs/quota2.c	1970-01-01 09:00:00
+++ b/fs/ufs/quota2.c	2026-10-28 05:06:44
@@ -0,0 +1,506 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Keep NetBSD's in-filesystem quotas (quota2) up to date when writing.
+ * See quota2.h for the layout.
+ *
+ * Usage is charged from the inode's own block count rather than at each
+ * allocation: every inode remembers how many 512-byte blocks have been
+ * charged for it (i_q2_blocks), and ufs_quota2_sync_blocks() charges the
+ * difference.  Block allocation runs under s_lock, which growing the
+ * quota file needs too, so the charge is made at points where s_lock is
+ * not held: on leaving ufs_getfrag_block(), at the end of a truncate,
+ * when an inode is freed, and before its owner changes.
+ *
+ * Limits are not enforced here; usage is counted so that NetBSD's fsck
+ * finds it consistent.
+ */
+
+#include <linux/fs.h>
+#include <linux/pagemap.h>
+#include <linux/highmem.h>
+
+#include "ufs_fs.h"
+#include "ufs.h"
+#include "swab.h"
+#include "util.h"
+#include "quota2.h"
+
+/* The NetBSD layout, which quota2.h restates field by field. */
+static_assert(sizeof(struct ufs_q2_val) == 40);
+static_assert(sizeof(struct ufs_q2_entry) == 96);
+static_assert(offsetof(struct ufs_q2_header, q2h_entries) == 112);
+
+/* The quota inodes' i_rwsem nests inside that of the inode being written. */
+static struct lock_class_key ufs_q2_rwsem_key;
+
+static bool ufs_q2_is_quota_inode(struct inode *inode)
+{
+	struct ufs_sb_info *sbi = UFS_SB(inode->i_sb);
+
+	return inode == sbi->s_q2_inode[UFS_Q2_USR] ||
+	       inode == sbi->s_q2_inode[UFS_Q2_GRP];
+}
+
+bool ufs_quota2_active(struct super_block *sb)
+{
+	struct ufs_sb_info *sbi = UFS_SB(sb);
+
+	return sbi->s_q2_inode[UFS_Q2_USR] || sbi->s_q2_inode[UFS_Q2_GRP];
+}
+
+/*
+ * Copy @len bytes between @buf and the quota file at @pos, through its
+ * page cache.  An entry may straddle a folio boundary, so this goes a
+ * folio at a time.  Only the part inside i_size is touched; extending the
+ * file is ufs_q2_extend()'s job.
+ */
+static int ufs_q2_rw(struct inode *qi, loff_t pos, void *buf, size_t len,
+		     bool write)
+{
+	if (pos < 0 || pos + len > i_size_read(qi))
+		return -EIO;
+
+	while (len) {
+		struct folio *folio;
+		size_t off, n;
+
+		folio = read_mapping_folio(qi->i_mapping, pos >> PAGE_SHIFT,
+					   NULL);
+		if (IS_ERR(folio))
+			return PTR_ERR(folio);
+		off = offset_in_folio(folio, pos);
+		n = min(len, folio_size(folio) - off);
+		if (write) {
+			folio_lock(folio);
+			memcpy_to_folio(folio, off, buf, n);
+			folio_mark_dirty(folio);
+			folio_unlock(folio);
+		} else {
+			memcpy_from_folio(buf, folio, off, n);
+		}
+		folio_put(folio);
+		pos += n;
+		buf += n;
+		len -= n;
+	}
+	return 0;
+}
+
+/* Append @len zero bytes to the quota file, allocating its blocks. */
+static int ufs_q2_extend(struct inode *qi, size_t len)
+{
+	const struct address_space_operations *aops = qi->i_mapping->a_ops;
+	loff_t pos;
+	int err = 0;
+
+	inode_lock(qi);
+	pos = i_size_read(qi);
+	while (len) {
+		struct folio *folio;
+		void *fsdata = NULL;
+		size_t n = min_t(size_t, len, PAGE_SIZE - offset_in_page(pos));
+		int copied;
+
+		err = aops->write_begin(NULL, qi->i_mapping, pos, n, &folio,
+					&fsdata);
+		if (err)
+			break;
+		folio_zero_range(folio, offset_in_folio(folio, pos), n);
+		copied = aops->write_end(NULL, qi->i_mapping, pos, n, n, folio,
+					 fsdata);
+		if (copied < 0) {
+			err = copied;
+			break;
+		}
+		if (copied != n) {
+			err = -EIO;
+			break;
+		}
+		pos += n;
+		len -= n;
+	}
+	inode_unlock(qi);
+	return err;
+}
+
+static int ufs_q2_read_header(struct inode *qi, struct ufs_q2_header *h)
+{
+	return ufs_q2_rw(qi, 0, h, sizeof(*h), false);
+}
+
+static int ufs_q2_write_free(struct super_block *sb, struct inode *qi,
+			     const struct ufs_q2_header *h)
+{
+	return ufs_q2_rw(qi, offsetof(struct ufs_q2_header, q2h_free),
+			 (void *)&h->q2h_free, sizeof(h->q2h_free), true);
+}
+
+/* Where the hash chain for @id starts: ufs_quota2.c hashes on the low bits. */
+static loff_t ufs_q2_head_pos(const struct ufs_q2_header *h, u32 id)
+{
+	u32 mask = (1U << h->q2h_hash_shift) - 1;
+
+	return offsetof(struct ufs_q2_header, q2h_entries) +
+	       (loff_t)(id & mask) * sizeof(h->q2h_entries[0]);
+}
+
+/*
+ * Find the entry for @id.  Returns 0 with its offset in *@off, which is 0
+ * when there is none.  A chain longer than the file can hold entries is a
+ * loop.
+ */
+static int ufs_q2_find(struct super_block *sb, struct inode *qi,
+		       const struct ufs_q2_header *h, u32 id, u64 *off)
+{
+	u64 max_steps = i_size_read(qi) / sizeof(struct ufs_q2_entry);
+	struct ufs_q2_entry e;
+	__fs64 next;
+	u64 pos;
+	int err;
+
+	err = ufs_q2_rw(qi, ufs_q2_head_pos(h, id), &next, sizeof(next),
+			false);
+	if (err)
+		return err;
+	for (pos = fs64_to_cpu(sb, next); pos;
+	     pos = fs64_to_cpu(sb, e.q2e_next)) {
+		if (!max_steps--)
+			return -EIO;
+		err = ufs_q2_rw(qi, pos, &e, sizeof(e), false);
+		if (err)
+			return err;
+		if (fs32_to_cpu(sb, e.q2e_uid) == id) {
+			*off = pos;
+			return 0;
+		}
+	}
+	*off = 0;
+	return 0;
+}
+
+/*
+ * Add a filesystem block of free entries to the end of the quota file and
+ * put them on the free list, as quota2_q2ealloc() does through
+ * quota2_addfreeq2e() when the list is empty.
+ */
+static int ufs_q2_grow(struct super_block *sb, struct inode *qi,
+		       struct ufs_q2_header *h)
+{
+	unsigned int bsize = UFS_SB(sb)->s_uspi->s_bsize;
+	loff_t base = i_size_read(qi);
+	unsigned int i, n = bsize / sizeof(struct ufs_q2_entry);
+	int err;
+
+	/* NetBSD keeps the quota file a whole number of blocks long. */
+	if (base % bsize)
+		return -EIO;
+	err = ufs_q2_extend(qi, bsize);
+	if (err)
+		return err;
+	for (i = 0; i < n; i++) {
+		loff_t pos = base + (loff_t)i * sizeof(struct ufs_q2_entry);
+		struct ufs_q2_entry e = { .q2e_next = h->q2h_free };
+
+		err = ufs_q2_rw(qi, pos, &e, sizeof(e), true);
+		if (err)
+			return err;
+		h->q2h_free = cpu_to_fs64(sb, pos);
+	}
+	return ufs_q2_write_free(sb, qi, h);
+}
+
+/*
+ * Take an entry off the free list, fill it from the default entry and
+ * link it into @id's hash chain: quota2_q2ealloc().
+ */
+static int ufs_q2_alloc(struct super_block *sb, struct inode *qi,
+			struct ufs_q2_header *h, u32 id, u64 *off)
+{
+	struct ufs_q2_entry e;
+	loff_t head = ufs_q2_head_pos(h, id);
+	__fs64 first;
+	u64 pos;
+	int err;
+
+	if (!h->q2h_free) {
+		err = ufs_q2_grow(sb, qi, h);
+		if (err)
+			return err;
+	}
+	pos = fs64_to_cpu(sb, h->q2h_free);
+	err = ufs_q2_rw(qi, pos, &e, sizeof(e), false);
+	if (err)
+		return err;
+	h->q2h_free = e.q2e_next;
+
+	err = ufs_q2_rw(qi, head, &first, sizeof(first), false);
+	if (err)
+		return err;
+	e = h->q2h_defentry;
+	e.q2e_uid = cpu_to_fs32(sb, id);
+	e.q2e_next = first;
+	err = ufs_q2_rw(qi, pos, &e, sizeof(e), true);
+	if (err)
+		return err;
+
+	first = cpu_to_fs64(sb, pos);
+	err = ufs_q2_rw(qi, head, &first, sizeof(first), true);
+	if (err)
+		return err;
+	err = ufs_q2_write_free(sb, qi, h);
+	if (err)
+		return err;
+	*off = pos;
+	return 0;
+}
+
+/*
+ * Add @delta to the @ql usage of @id in the quota of @type: the
+ * bookkeeping half of quota2_check().  An id with no entry has nothing
+ * to give back, so a decrease leaves it alone; usage does not go below 0.
+ */
+static int ufs_q2_charge(struct super_block *sb, int type, u32 id, int ql,
+			 s64 delta)
+{
+	struct inode *qi = UFS_SB(sb)->s_q2_inode[type];
+	struct ufs_q2_header h;
+	loff_t cur_pos;
+	__fs64 cur;
+	u64 off, val;
+	int err;
+
+	if (!qi || !delta)
+		return 0;
+	err = ufs_q2_read_header(qi, &h);
+	if (err)
+		return err;
+	err = ufs_q2_find(sb, qi, &h, id, &off);
+	if (err)
+		return err;
+	if (!off) {
+		if (delta < 0)
+			return 0;
+		err = ufs_q2_alloc(sb, qi, &h, id, &off);
+		if (err)
+			return err;
+	}
+
+	cur_pos = off + offsetof(struct ufs_q2_entry, q2e_val[ql].q2v_cur);
+	err = ufs_q2_rw(qi, cur_pos, &cur, sizeof(cur), false);
+	if (err)
+		return err;
+	val = fs64_to_cpu(sb, cur);
+	if (delta < 0)
+		val = val < (u64)-delta ? 0 : val + delta;
+	else
+		val += delta;
+	cur = cpu_to_fs64(sb, val);
+	return ufs_q2_rw(qi, cur_pos, &cur, sizeof(cur), true);
+}
+
+/* Charge @delta of @ql to both the user and the group. */
+static void ufs_q2_charge_owner(struct inode *inode, u32 uid, u32 gid,
+				int ql, s64 delta)
+{
+	struct super_block *sb = inode->i_sb;
+	int err;
+
+	err = ufs_q2_charge(sb, UFS_Q2_USR, uid, ql, delta);
+	if (!err)
+		err = ufs_q2_charge(sb, UFS_Q2_GRP, gid, ql, delta);
+	if (err)
+		ufs_warning(sb, __func__,
+			    "inode %llu: quota update failed (%d)\n",
+			    (unsigned long long)inode->i_ino, err);
+}
+
+/* Charge the blocks the inode gained or lost since the last charge. */
+static void __ufs_quota2_sync_blocks(struct inode *inode)
+{
+	struct ufs_inode_info *ufsi = UFS_I(inode);
+	blkcnt_t blocks;
+
+	spin_lock(&inode->i_lock);
+	blocks = inode->i_blocks;
+	spin_unlock(&inode->i_lock);
+	if (blocks == ufsi->i_q2_blocks)
+		return;
+	ufs_q2_charge_owner(inode, i_uid_read(inode), i_gid_read(inode),
+			    UFS_Q2_BLOCK, (s64)blocks - ufsi->i_q2_blocks);
+	ufsi->i_q2_blocks = blocks;
+}
+
+void ufs_quota2_sync_blocks(struct inode *inode)
+{
+	struct ufs_sb_info *sbi = UFS_SB(inode->i_sb);
+
+	if (!ufs_quota2_active(inode->i_sb) || ufs_q2_is_quota_inode(inode))
+		return;
+	mutex_lock(&sbi->s_q2_lock);
+	__ufs_quota2_sync_blocks(inode);
+	mutex_unlock(&sbi->s_q2_lock);
+}
+
+void ufs_quota2_new_inode(struct inode *inode)
+{
+	struct ufs_sb_info *sbi = UFS_SB(inode->i_sb);
+
+	if (!ufs_quota2_active(inode->i_sb))
+		return;
+	mutex_lock(&sbi->s_q2_lock);
+	ufs_q2_charge_owner(inode, i_uid_read(inode), i_gid_read(inode),
+			    UFS_Q2_FILE, 1);
+	mutex_unlock(&sbi->s_q2_lock);
+}
+
+/* The inode is gone from the disk: give back its blocks and itself. */
+void ufs_quota2_free_inode(struct inode *inode)
+{
+	struct ufs_sb_info *sbi = UFS_SB(inode->i_sb);
+	struct ufs_inode_info *ufsi = UFS_I(inode);
+	u32 uid = i_uid_read(inode), gid = i_gid_read(inode);
+
+	if (!ufs_quota2_active(inode->i_sb) || ufs_q2_is_quota_inode(inode))
+		return;
+	mutex_lock(&sbi->s_q2_lock);
+	ufs_q2_charge_owner(inode, uid, gid, UFS_Q2_BLOCK, -ufsi->i_q2_blocks);
+	ufsi->i_q2_blocks = 0;
+	ufs_q2_charge_owner(inode, uid, gid, UFS_Q2_FILE, -1);
+	mutex_unlock(&sbi->s_q2_lock);
+}
+
+/*
+ * Move the inode's usage to its new owner before setattr_copy() changes
+ * it, as ufs_chown() does with chkdq() and chkiq().
+ */
+int ufs_quota2_transfer(struct inode *inode, const struct iattr *attr)
+{
+	struct super_block *sb = inode->i_sb;
+	struct ufs_sb_info *sbi = UFS_SB(sb);
+	struct ufs_inode_info *ufsi = UFS_I(inode);
+	bool uid_changes = i_uid_needs_update(&nop_mnt_idmap, attr, inode);
+	bool gid_changes = i_gid_needs_update(&nop_mnt_idmap, attr, inode);
+	u32 old_id, new_id;
+	s64 blocks;
+
+	if (!ufs_quota2_active(sb) || ufs_q2_is_quota_inode(inode))
+		return 0;
+	if (!uid_changes && !gid_changes)
+		return 0;
+
+	mutex_lock(&sbi->s_q2_lock);
+	__ufs_quota2_sync_blocks(inode);
+	blocks = ufsi->i_q2_blocks;
+	if (uid_changes) {
+		old_id = i_uid_read(inode);
+		new_id = from_kuid(&init_user_ns,
+				   from_vfsuid(&nop_mnt_idmap, i_user_ns(inode),
+					       attr->ia_vfsuid));
+		ufs_q2_charge(sb, UFS_Q2_USR, old_id, UFS_Q2_BLOCK, -blocks);
+		ufs_q2_charge(sb, UFS_Q2_USR, old_id, UFS_Q2_FILE, -1);
+		ufs_q2_charge(sb, UFS_Q2_USR, new_id, UFS_Q2_BLOCK, blocks);
+		ufs_q2_charge(sb, UFS_Q2_USR, new_id, UFS_Q2_FILE, 1);
+	}
+	if (gid_changes) {
+		old_id = i_gid_read(inode);
+		new_id = from_kgid(&init_user_ns,
+				   from_vfsgid(&nop_mnt_idmap, i_user_ns(inode),
+					       attr->ia_vfsgid));
+		ufs_q2_charge(sb, UFS_Q2_GRP, old_id, UFS_Q2_BLOCK, -blocks);
+		ufs_q2_charge(sb, UFS_Q2_GRP, old_id, UFS_Q2_FILE, -1);
+		ufs_q2_charge(sb, UFS_Q2_GRP, new_id, UFS_Q2_BLOCK, blocks);
+		ufs_q2_charge(sb, UFS_Q2_GRP, new_id, UFS_Q2_FILE, 1);
+	}
+	mutex_unlock(&sbi->s_q2_lock);
+	return 0;
+}
+
+/*
+ * Check what the superblock says about a quota file before trusting it:
+ * the header must be one quota2_create_blk0() could have written for this
+ * @type, and the file must hold the header and its hash table.
+ */
+static int ufs_q2_check(struct super_block *sb, struct inode *qi, int type)
+{
+	struct ufs_q2_header h;
+	loff_t table_end;
+	int err;
+
+	if (!S_ISREG(qi->i_mode) || !qi->i_nlink)
+		return -EIO;
+	if (i_size_read(qi) < (loff_t)sizeof(h))
+		return -EIO;
+	err = ufs_q2_read_header(qi, &h);
+	if (err)
+		return err;
+	if (fs32_to_cpu(sb, h.q2h_magic_number) != UFS_Q2_HEAD_MAGIC ||
+	    h.q2h_type != type || h.q2h_hash_shift > 15 ||
+	    fs16_to_cpu(sb, h.q2h_hash_size) != 1U << h.q2h_hash_shift)
+		return -EIO;
+	table_end = offsetof(struct ufs_q2_header, q2h_entries) +
+		    ((loff_t)sizeof(h.q2h_entries[0]) << h.q2h_hash_shift);
+	if (i_size_read(qi) < table_end)
+		return -EIO;
+	return 0;
+}
+
+/*
+ * NetBSD marks a filesystem that keeps quota2 with Q2_HEAD_MAGIC in
+ * fs_quota_magic and one FS_Q2_DO_TYPE() bit per kind in fs_quota_flags,
+ * and names the quota inodes in fs_quotafile[] (newfs/mkfs.c).  FreeBSD
+ * leaves the same bytes zero.
+ */
+int ufs_quota2_load(struct super_block *sb)
+{
+	struct ufs_sb_info *sbi = UFS_SB(sb);
+	struct ufs_super_block_second *usb2 = ubh_get_usb_second(sbi->s_uspi);
+	u8 kinds;
+	int type, err;
+
+	if ((sbi->s_flags & UFS_ST_MASK) != UFS_ST_44BSD)
+		return 0;
+	if (fs32_to_cpu(sb, usb2->fs_un.fs_u2.fs_quota_magic) !=
+	    UFS_Q2_HEAD_MAGIC)
+		return 0;
+
+	kinds = usb2->fs_un.fs_u2.fs_quota_flags;
+	for (type = 0; type < UFS_Q2_NTYPES; type++) {
+		struct inode *qi;
+		u64 ino;
+
+		if (!(kinds & UFS_Q2_DO_TYPE(type)))
+			continue;
+		ino = fs64_to_cpu(sb, usb2->fs_un.fs_u2.fs_quotafile[type]);
+		qi = ufs_iget(sb, ino);
+		if (IS_ERR(qi)) {
+			err = PTR_ERR(qi);
+			goto fail;
+		}
+		lockdep_set_class(&qi->i_rwsem, &ufs_q2_rwsem_key);
+		sbi->s_q2_inode[type] = qi;
+		err = ufs_q2_check(sb, qi, type);
+		if (err)
+			goto fail;
+	}
+	return 0;
+
+fail:
+	ufs_quota2_unload(sb);
+	return err;
+}
+
+void ufs_quota2_unload(struct super_block *sb)
+{
+	struct ufs_sb_info *sbi = UFS_SB(sb);
+	int type;
+
+	for (type = 0; type < UFS_Q2_NTYPES; type++) {
+		struct inode *qi = sbi->s_q2_inode[type];
+
+		if (!qi)
+			continue;
+		sbi->s_q2_inode[type] = NULL;
+		write_inode_now(qi, 1);
+		iput(qi);
+	}
+}
