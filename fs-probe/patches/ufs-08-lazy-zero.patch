+/*
+ * How many of the @n fragments of @inode from file fragment @fragment lie
+ * before EOF.
+ */
+static unsigned int ufs_frags_before_eof(struct inode *inode, u64 fragment,
+					 unsigned int n)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(inode->i_sb)->s_uspi;
+	u64 eof = ((u64)i_size_read(inode) + uspi->s_fsize - 1) >>
+		  uspi->s_fshift;
+
+	if (fragment >= eof)
+		return 0;
+	return (unsigned int)min_t(u64, n, eof - fragment);
+}
