 /*
+ * FreeBSD keeps CRC32C check-hashes of the superblock, the cylinder
+ * groups and the inodes when FS_METACKHASH is set in fs_flags, and
+ * names which of them in fs_metackhash.  This driver does not update
+ * them, so after it has written, FreeBSD finds them stale and refuses
+ * to mount the filesystem.  FreeBSD's fs.h asks a kernel that does not
+ * maintain check-hashes to clear FS_METACKHASH; FreeBSD then stops
+ * verifying them on its next mount, and fsck rebuilds them.
+ *
+ * NetBSD uses the same bit for FS_DOQUOTA2 and keeps fs_metackhash as
+ * spare space, which is zero, so the bit is only cleared when
+ * fs_metackhash names a check-hash.
+ */
+static void ufs_clear_metackhash(struct super_block *sb)
+{
+	struct ufs_sb_private_info *uspi = UFS_SB(sb)->s_uspi;
+	struct ufs_super_block_third *usb3 = ubh_get_usb_third(uspi);
+	u32 flags;
+
+	if ((UFS_SB(sb)->s_flags & UFS_ST_MASK) != UFS_ST_44BSD)
+		return;
+	if (!usb3->fs_un2.fs_44.fs_metackhash)
+		return;
+	flags = fs32_to_cpu(sb, usb3->fs_un2.fs_44.fs_flags);
+	if (!(flags & UFS_METACKHASH))
+		return;
+	usb3->fs_un2.fs_44.fs_flags = cpu_to_fs32(sb, flags & ~UFS_METACKHASH);
+	ubh_mark_buffer_dirty(USPI_UBH(uspi));
+	pr_info("%s: clearing FreeBSD metadata check-hashes; fsck_ffs on FreeBSD rebuilds them\n",
+		sb->s_id);
+}
+
