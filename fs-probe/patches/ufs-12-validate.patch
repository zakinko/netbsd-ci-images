+/*
+ * The header is read again for every update, and an entry offset taken
+ * from the file could have pointed back into it, so check it each time
+ * rather than only at load: q2h_hash_shift becomes a shift count.
+ */
+static int ufs_q2_read_header(struct super_block *sb, struct inode *qi,
+			      int type, struct ufs_q2_header *h)
+{
+	int err;
+
+	err = ufs_q2_read(qi, 0, h, sizeof(*h));
+	if (err)
+		return err;
+	if (fs32_to_cpu(sb, h->q2h_magic_number) != UFS_Q2_HEAD_MAGIC ||
+	    h->q2h_type != type || h->q2h_hash_shift > 15 ||
+	    fs16_to_cpu(sb, h->q2h_hash_size) != 1U << h->q2h_hash_shift)
+		return -EIO;
+	if (ufs_q2_size(qi) < ufs_q2_table_end(h))
+		return -EIO;
+	return 0;
+}
+
+/*
+ * An entry offset read from the file, from a hash chain or the free
+ * list.  One inside the header or the hash table would have the next
+ * write land there.
+ */
+static int ufs_q2_check_entry_pos(const struct ufs_q2_header *h, u64 pos)
+{
+	return pos < ufs_q2_table_end(h) ? -EIO : 0;
+}
