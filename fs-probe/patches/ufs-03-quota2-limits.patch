+/*
+ * May @change more of @ql be charged to @id in the quota of @type?  The
+ * test is quota_check_limit() (quota2_subr.c): over the hard limit is
+ * refused, over the soft limit is refused once its grace time has run
+ * out.  Crossing the soft limit starts the grace time whether or not the
+ * charge is then refused, as quota2_check() records it before knowing.
+ * Returns -EDQUOT only when @enforce is set.
+ */
+static int ufs_q2_limit(struct super_block *sb, int type, u32 id,
+			unsigned int ql, u64 change, bool enforce)
+{
+	struct inode *qi = UFS_SB(sb)->s_q2_inode[type];
+	time64_t now = ktime_get_real_seconds();
+	bool deny = false, cross = false;
+	struct ufs_q2_val v;
+	u64 off, pos, cur, soft, hard;
+	int err;
+
+	if (!qi || !change)
+		return 0;
+	err = ufs_q2_lookup(sb, qi, id, true, &off);
+	if (err)
+		return err;
+	pos = ufs_q2_val_pos(off, ql);
+	err = ufs_q2_read(qi, pos, &v, sizeof(v));
+	if (err)
+		return err;
+	cur = fs64_to_cpu(sb, v.q2v_cur);
+	soft = fs64_to_cpu(sb, v.q2v_softlimit);
+	hard = fs64_to_cpu(sb, v.q2v_hardlimit);
+
+	if (ufs_q2_exceeds(cur, change, hard)) {
+		cross = cur <= soft;
+		deny = true;
+	} else if (ufs_q2_exceeds(cur, change, soft)) {
+		cross = cur <= soft;
+		deny = !cross && now > (time64_t)fs64_to_cpu(sb, v.q2v_time);
+	}
