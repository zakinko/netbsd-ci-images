+	if (cross) {
+		time64_t grace = (time64_t)fs64_to_cpu(sb, v.q2v_grace);
+
+		v.q2v_time = cpu_to_fs64(sb, (u64)(now + grace));
+		err = ufs_q2_write(qi, pos + offsetof(struct ufs_q2_val, q2v_time),
+				   &v.q2v_time, sizeof(v.q2v_time));
+		if (err)
+			return err;
+	}
+	return deny && enforce ? -EDQUOT : 0;
