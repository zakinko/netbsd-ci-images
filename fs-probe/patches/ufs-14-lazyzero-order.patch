+/*
+ * With -o lazyzero the zeroes of a filled hole are in the page cache when
+ * the block pointer is set.  Were the pointer to reach the device first, a
+ * crash would leave the file naming a block that still holds what it held
+ * before it was freed, which may be another user's data.  So:
+ *
+ * A pointer in the inode is written by ufs_update_inode() alone, and an
+ * indirect block belongs to one inode.  Keep such an indirect buffer clean
+ * and on i_held_bhs while it carries pointers to blocks that may not have
+ * been zeroed yet, and write the pointers only once the file's data is on
+ * the device; see ufs_order_inode().
+ *
+ * The buffer has to be clean before the pointer goes in, or writing out
+ * what made it dirty would take the pointer along.  This costs a write per
+ * buffer of pointers, once per pass of ufs_order_inode().
+ */
+struct ufs_held_bh {
+	struct list_head list;
+	struct buffer_head *bh;
+};
+
+BUFFER_FNS(PrivateStart, ufs_held)
+
+static void ufs_hold_indirect(struct inode *inode, struct buffer_head *bh)
+{
+	struct ufs_held_bh *held;
+
+	if (buffer_ufs_held(bh))
+		return;
+	sync_dirty_buffer(bh);
+	/* A few bytes, and the block allocation cannot be refused here. */
+	held = kmalloc(sizeof(*held), GFP_NOFS | __GFP_NOFAIL);
+	get_bh(bh);
+	held->bh = bh;
+	set_buffer_ufs_held(bh);
+	list_add_tail(&held->list, &UFS_I(inode)->i_held_bhs);
+}
+
+/* Let go of the held buffers, marking them dirty.  Stable under the caller. */
+static int ufs_release_held(struct inode *inode, bool sync)
+{
+	struct ufs_held_bh *held, *next;
+	int err = 0;
+
+	list_for_each_entry_safe(held, next, &UFS_I(inode)->i_held_bhs, list) {
+		clear_buffer_ufs_held(held->bh);
+		mark_buffer_dirty(held->bh);
+		if (sync && !err)
+			err = sync_dirty_buffer(held->bh);
+		brelse(held->bh);
+		list_del(&held->list);
+		kfree(held);
+	}
+	return err;
+}
+
+/**
+ * ufs_order_inode() - write the data of @inode ahead of its pointers
+ * @inode: pointer to inode
+ * @sync: keep trying while new holes are being filled
+ *
+ * Writing the data can itself allocate, through writepages, so
+ * truncate_mutex cannot be held across it.  Hence the test afterwards that
+ * nothing was allocated meanwhile.
+ *
+ * Return: 0 with truncate_mutex held, the held buffers marked dirty, and
+ * pointers in the inode safe to write until it is unlocked.  Otherwise an
+ * error without it: -EAGAIN if !@sync and holes were being filled.
+ */
+static int ufs_order_inode(struct inode *inode, bool sync)
+{
+	struct ufs_inode_info *ufsi = UFS_I(inode);
+	int err;
+
+	for (;;) {
+		mutex_lock(&ufsi->truncate_mutex);
+		if (!ufsi->i_unordered)
+			break;
+		ufsi->i_unordered = 0;
+		mutex_unlock(&ufsi->truncate_mutex);
+
+		err = filemap_write_and_wait(inode->i_mapping);
+		if (err) {
+			mutex_lock(&ufsi->truncate_mutex);
+			ufsi->i_unordered = 1;
+			mutex_unlock(&ufsi->truncate_mutex);
+			return err;
+		}
+		mutex_lock(&ufsi->truncate_mutex);
+		if (!ufsi->i_unordered)
+			break;
+		mutex_unlock(&ufsi->truncate_mutex);
+		if (!sync)
+			return -EAGAIN;
+	}
+	err = ufs_release_held(inode, sync);
+	if (err)
+		mutex_unlock(&ufsi->truncate_mutex);
+	return err;
+}
