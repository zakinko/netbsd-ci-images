+/*
+ * Point a virtio 1.0 device at one virtqueue.  The three areas of the ring
+ * are handed over separately as 64 bit addresses, the queue has to be
+ * enabled explicitly, and the offset used to kick it is read here and kept
+ * for vtpci_notify_virtqueue().
+ */
+static void
+vtpci_setup_modern_vq(struct vtpci_softc *sc, uint16_t queue,
+    struct virtqueue *vq)
+{
+	vm_paddr_t desc, avail, used;
+
+	desc = virtqueue_desc_paddr(vq);
+	avail = virtqueue_avail_paddr(vq);
+	used = virtqueue_used_paddr(vq);
+
+	vtpci_m_write_4(sc, VIRTIO_PCI_M_QDESCLO, desc);
+	vtpci_m_write_4(sc, VIRTIO_PCI_M_QDESCHI, desc >> 32);
+	vtpci_m_write_4(sc, VIRTIO_PCI_M_QAVAILLO, avail);
+	vtpci_m_write_4(sc, VIRTIO_PCI_M_QAVAILHI, avail >> 32);
+	vtpci_m_write_4(sc, VIRTIO_PCI_M_QUSEDLO, used);
+	vtpci_m_write_4(sc, VIRTIO_PCI_M_QUSEDHI, used >> 32);
+
+	sc->vtpci_vq_notify_off[queue] =
+	    vtpci_m_read_2(sc, VIRTIO_PCI_M_QNOTIFY_OFF);
+
+	vtpci_m_write_2(sc, VIRTIO_PCI_M_QENABLE, 1);
+}
