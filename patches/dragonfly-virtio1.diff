+/*
+ * Walk the PCI capability list looking for a virtio vendor capability of the
+ * given cfg_type.  pci_find_extcap() only reports the first capability of an
+ * ID, and a virtio 1.0 device carries four vendor capabilities, so the list
+ * has to be walked by hand.
+ */
+static int
+vtpci_find_cap(device_t dev, uint8_t cfg_type, int *offp)
+{
+	uint8_t ptr, type;
+	int i;
+
+	if ((pci_read_config(dev, PCIR_STATUS, 2) & PCIM_STATUS_CAPPRESENT) == 0)
+		return (ENXIO);
+
+	ptr = pci_read_config(dev, PCIR_CAP_PTR, 1);
+	/* Bound the walk; a broken device could point the list at itself. */
+	for (i = 0; ptr != 0 && i < 48; i++) {
+		if (pci_read_config(dev, ptr + PCICAP_ID, 1) == PCIY_VENDOR) {
+			type = pci_read_config(dev,
+			    ptr + VIRTIO_PCI_CAP_CFG_TYPE, 1);
+			if (type == cfg_type) {
+				*offp = ptr;
+				return (0);
+			}
+		}
+		ptr = pci_read_config(dev, ptr + PCICAP_NEXTPTR, 1);
+	}
+
+	return (ENXIO);
+}
+
+/*
+ * Map one of the structures a virtio 1.0 device advertises.  The capability
+ * names the BAR and the offset within it; several structures usually share
+ * one BAR, so the resource is allocated per rid and reused.
+ */
+static int
+vtpci_map_cap(struct vtpci_softc *sc, uint8_t cfg_type, struct resource **resp,
+    int *ridp, bus_size_t *offp, uint32_t *multp)
+{
+	device_t dev = sc->vtpci_dev;
+	int cap, rid;
+	uint8_t bar;
+
+	if (vtpci_find_cap(dev, cfg_type, &cap) != 0)
+		return (ENXIO);
+
+	bar = pci_read_config(dev, cap + VIRTIO_PCI_CAP_BAR, 1);
+	*offp = pci_read_config(dev, cap + VIRTIO_PCI_CAP_OFFSET, 4);
+	if (multp != NULL) {
+		*multp = pci_read_config(dev,
+		    cap + VIRTIO_PCI_CAP_NOTIFY_OFF_MULT, 4);
+	}
+
+	rid = PCIR_BAR(bar);
+	*ridp = rid;
+
+	/* Already mapped for another structure in the same BAR? */
+	if (sc->vtpci_common_res != NULL && sc->vtpci_common_rid == rid) {
+		*resp = sc->vtpci_common_res;
+		return (0);
+	}
+	if (sc->vtpci_notify_res != NULL && sc->vtpci_notify_rid == rid) {
+		*resp = sc->vtpci_notify_res;
+		return (0);
+	}
+	if (sc->vtpci_isr_res != NULL && sc->vtpci_isr_rid == rid) {
+		*resp = sc->vtpci_isr_res;
+		return (0);
+	}
+
+	*resp = bus_alloc_resource_any(dev, SYS_RES_MEMORY, &rid, RF_ACTIVE);
+	if (*resp == NULL)
+		return (ENXIO);
+
+	return (0);
+}
+
+static int
+vtpci_map_modern(struct vtpci_softc *sc)
+{
+	device_t dev = sc->vtpci_dev;
+	int error;
+
+	error = vtpci_map_cap(sc, VIRTIO_PCI_CAP_COMMON_CFG,
+	    &sc->vtpci_common_res, &sc->vtpci_common_rid,
+	    &sc->vtpci_common_off, NULL);
+	if (error) {
+		device_printf(dev, "no common configuration capability\n");
+		return (error);
+	}
+
+	error = vtpci_map_cap(sc, VIRTIO_PCI_CAP_NOTIFY_CFG,
+	    &sc->vtpci_notify_res, &sc->vtpci_notify_rid,
+	    &sc->vtpci_notify_off, &sc->vtpci_notify_off_mult);
+	if (error) {
+		device_printf(dev, "no notify capability\n");
+		return (error);
+	}
+
+	error = vtpci_map_cap(sc, VIRTIO_PCI_CAP_ISR_CFG,
+	    &sc->vtpci_isr_res, &sc->vtpci_isr_rid, &sc->vtpci_isr_off, NULL);
+	if (error) {
+		device_printf(dev, "no ISR capability\n");
+		return (error);
+	}
+
+	/*
+	 * The device configuration structure is optional: a device with no
+	 * device-specific configuration space does not advertise one.
+	 */
+	if (vtpci_map_cap(sc, VIRTIO_PCI_CAP_DEVICE_CFG, &sc->vtpci_device_res,
+	    &sc->vtpci_device_rid, &sc->vtpci_device_off, NULL) != 0) {
+		sc->vtpci_device_res = NULL;
+	}
+
+	return (0);
+}
