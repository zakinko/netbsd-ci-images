+#define VIRTIO_CONFIG1_QUEUE_AVAIL		40 /* 64 bit RW */
+#define VIRTIO_CONFIG1_QUEUE_USED		48 /* 64 bit RW */
+
+
+#endif /* _DEV_PCI_VIRTIO_PCIREG_H_ */
