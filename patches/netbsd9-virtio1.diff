+static int
+vioif_rx_intr(void *arg)
+{
+	struct vioif_netqueue *netq = arg;
+	struct virtqueue *vq = netq->netq_vq;
+	struct virtio_softc *vsc = vq->vq_owner;
+	struct vioif_softc *sc = device_private(virtio_child(vsc));
